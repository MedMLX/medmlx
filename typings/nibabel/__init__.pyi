"""Nibabel 5.4 public NIfTI surface used by MedMLX.

Signatures match loadsave.py, spatialimages.py and nifti1.py/nifti2.py.
Only the APIs consumed here are declared; no permissive attribute fallback.
"""

from os import PathLike
from typing import Literal, Self, overload

import numpy as np
from numpy.typing import ArrayLike, DTypeLike, NDArray

type FileSpec = str | PathLike[str]

class FileBasedImage: ...

class Nifti1Header:
    def copy(self) -> Self: ...
    def get_xyzt_units(self) -> tuple[str, str]: ...
    def set_xyzt_units(self, xyz: str | None = None, t: str | None = None) -> None: ...
    def set_data_dtype(self, datatype: DTypeLike) -> None: ...
    def get_zooms(self) -> tuple[float, ...]: ...

class Nifti2Header(Nifti1Header): ...

class Nifti1Image(FileBasedImage):
    def __init__(
        self, dataobj: NDArray[np.generic], affine: NDArray[np.float64] | None,
        header: Nifti1Header | None = None,
    ) -> None: ...
    @property
    def affine(self) -> NDArray[np.float64] | None: ...
    @property
    def header(self) -> Nifti1Header: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def dataobj(self) -> ArrayLike: ...
    def get_data_dtype(self) -> np.dtype[np.generic]: ...
    def set_qform(self, affine: NDArray[np.float64] | None, code: int | None = None) -> None: ...
    def set_sform(self, affine: NDArray[np.float64] | None, code: int | None = None) -> None: ...
    @overload
    def get_qform(self, coded: Literal[True]) -> tuple[NDArray[np.float64] | None, int]: ...
    @overload
    def get_qform(self, coded: Literal[False] = False) -> NDArray[np.float64]: ...
    @overload
    def get_sform(self, coded: Literal[True]) -> tuple[NDArray[np.float64] | None, int]: ...
    @overload
    def get_sform(self, coded: Literal[False] = False) -> NDArray[np.float64]: ...
    @overload
    def get_fdata(
        self, caching: Literal['fill', 'unchanged'] = 'fill',
        dtype: type[np.float64] = np.float64,
    ) -> NDArray[np.float64]: ...
    @overload
    def get_fdata(
        self, caching: Literal['fill', 'unchanged'] = 'fill', *, dtype: type[np.float32],
    ) -> NDArray[np.float32]: ...

class Nifti2Image(Nifti1Image): ...

def load(filename: FileSpec) -> FileBasedImage: ...
def save(img: FileBasedImage, filename: FileSpec) -> None: ...
def as_closest_canonical(img: Nifti1Image, enforce_diag: bool = False) -> Nifti1Image: ...
