"""SimpleITK 2.5 DICOM series surface used by MedMLX and its tests.

Only the APIs consumed here are declared; no permissive attribute fallback.
"""

from collections.abc import Sequence

import numpy as np
from numpy.typing import NDArray

class Image:
    def GetSize(self) -> tuple[int, ...]: ...
    def GetSpacing(self) -> tuple[float, ...]: ...
    def SetSpacing(self, spacing: Sequence[float]) -> None: ...
    def SetOrigin(self, origin: Sequence[float]) -> None: ...
    def SetMetaData(self, key: str, value: str) -> None: ...

class ImageSeriesReader:
    def GetGDCMSeriesIDs(self, directory: str) -> tuple[str, ...]: ...
    def GetGDCMSeriesFileNames(self, directory: str, seriesID: str) -> tuple[str, ...]: ...
    def SetFileNames(self, fileNames: Sequence[str]) -> None: ...
    def Execute(self) -> Image: ...

class ImageFileReader:
    def SetFileName(self, fileName: str) -> None: ...
    def ReadImageInformation(self) -> None: ...
    def HasMetaDataKey(self, key: str) -> bool: ...
    def GetMetaData(self, key: str) -> str: ...

class ImageFileWriter:
    def KeepOriginalImageUIDOn(self) -> None: ...
    def SetFileName(self, fileName: str) -> None: ...
    def Execute(self, image: Image) -> None: ...

def GetImageFromArray(arr: NDArray[np.generic], isVector: bool = False) -> Image: ...
def WriteImage(image: Image, fileName: str) -> None: ...
